# Copia este archivo como ".env" y cambia los valores. El archivo ".env" esta en .gitignore: NUNCA se sube a Git.
DB_PASSWORD=cambia-esta-clave-de-la-base
# Cadena aleatoria de al menos 32 caracteres (firma los tokens de sesion)
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-de-32-o-mas-caracteres
# Clave del usuario "admin" que se crea la primera vez (minimo 10 caracteres)
ADMIN_PASSWORD=cambia-esta-clave-del-admin
